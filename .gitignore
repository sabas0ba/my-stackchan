# direnv および nix-direnv のキャッシュ
/.direnv/

# マシン固有の設定。秘密情報を含みうるため git 管理外とする (.envrc から読み込む)
.envrc.local

# nix build の成果物 symlink
result
result-*

# cargo の成果物
target/

# 作業用の一時ファイル置き場。リポジトリ外部 (/tmp 等) ではなくここを使用する。
# 配布物のダウンロード先 (.work/downloads) と CARGO_HOME (.work/cargo) を含む。
/.work/

# Claude Code がセッションごとに書き込む設定
/.claude/settings.local.json

# エディタおよび OS が生成する一時ファイル
*.swp
.DS_Store
