# shellcheck shell=bash
#
# direnv が本ディレクトリで読み込む設定。`direnv allow` を一度実行すると、以降は
# cd するだけで開発環境に入る。Linux ホストで nix を持つ場合にのみ使用する。

if ! has nix; then
  log_error "nix が見つかりません。Windows では scripts/container.sh を使用してください。"
  return 0
fi

watch_file flake.nix
watch_file flake.lock
watch_file nix/devshell.nix
watch_file nix/packages.nix
watch_file nix/checks.nix
watch_file nix/esp-rust.nix
watch_file nix/xtensa-gcc.nix
watch_file nix/cargo-vendor.nix
watch_file Cargo.lock
watch_file firmware/Cargo.lock

use flake .

# マシン固有の設定は .envrc.local に分離する。git 管理外。
source_env_if_exists .envrc.local
